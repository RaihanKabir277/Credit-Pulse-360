{
  "datasets": [
    {
      "name": "8879a10b",
      "displayName": "Portfolio Summary",
      "config": {
        "version": "1.1",
        "source": "creditpulse.gold.loan_portfolio_summary",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "f61f20c4",
      "displayName": "Application Funnel",
      "config": {
        "version": "1.1",
        "source": "creditpulse.gold.application_funnel",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          },
          {
            "displayName": "Approval Rate by Value",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            },
            "name": "approval_rate_by_value",
            "expr": "SUM(`total_approved_bdt`) / SUM(`total_requested_bdt`)",
            "comment": "Ratio of approved to requested loan value — computed by the query, moves automatically as approval patterns shift"
          }
        ]
      }
    },
    {
      "name": "e84b406f",
